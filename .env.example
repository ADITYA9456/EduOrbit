# ============================================================
#  EduOrbit — Environment Variables
#  Copy this file to ".env.local" and fill in real values:
#      cp .env.example .env.local        (macOS / Linux)
#      copy .env.example .env.local      (Windows cmd)
#  NEVER commit .env.local — it is gitignored.
# ============================================================

# ---- Supabase (REQUIRED) -----------------------------------
# Project URL and keys from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only secret — used by API routes/scripts. Keep private.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- AI video verification (OPTIONAL) ----------------------
# AI_PROVIDER controls how submitted videos are verified.
#   "mock"   -> no external calls, always-pass stub (good for local dev)
#   "gemini" -> uses Google Gemini (requires GEMINI_API_KEY below)
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key

# ---- YouTube Data API (OPTIONAL) ---------------------------
# Needed for in-app YouTube search/import. Without it, search is disabled.
YOUTUBE_API_KEY=your-youtube-data-api-key

# ---- LeetCode sync script (OPTIONAL) -----------------------
# Shared secret guarding the /api/sync-leetcode endpoint and the
# scripts/sync-leetcode-questions.js helper. Set any random string.
LEETCODE_SYNC_SECRET=choose-a-random-secret

# ---- App URL (OPTIONAL) ------------------------------------
# Public base URL of the deployment. Defaults to localhost in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
