# ============================================================
#  EduOrbit environment variables
#  Local: copy to .env.local and fill in.  Vercel: Project > Settings > Environment Variables.
#  Never commit real values. Anything prefixed NEXT_PUBLIC_ is visible in the browser.
# ============================================================

# ---- Supabase (REQUIRED) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Used by API routes (judge, admin). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Code judge: Judge0 CE (REQUIRED for Run / Submit) ------
# Base URL of a Judge0 CE instance, no trailing slash. Leave empty and the UI shows
# "Judge not configured" instead of failing. Server only.
JUDGE0_URL=
# Token if your instance requires one (self-hosted: AUTHN_TOKEN in judge0.conf).
JUDGE0_API_KEY=
# Header that carries the token. Default X-Auth-Token. RapidAPI: X-RapidAPI-Key.
JUDGE0_AUTH_HEADER=
# RapidAPI only: the host header value, e.g. judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=
# Optional: override language ids to match your Judge0 build (defaults: js 93, python 92, java 91, cpp 54, c 50)
# JUDGE0_LANG_JAVASCRIPT=93
# JUDGE0_LANG_PYTHON=92
# JUDGE0_LANG_JAVA=91
# JUDGE0_LANG_CPP=54
# JUDGE0_LANG_C=50
# Optional limits
# JUDGE0_MAX_CPU_SECONDS=15
# JUDGE_SUBMITS_PER_MINUTE=8
# JUDGE_REQUESTS_PER_MINUTE=20

# ---- Site ---------------------------------------------------
# Public base URL, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# ---- Second app link (optional) -----------------------------
# Adds the "Prep" link (academic-cap icon) to the sidebar and mobile menu. Leave empty to hide it.
NEXT_PUBLIC_SECOND_APP_URL=
NEXT_PUBLIC_SECOND_APP_NAME=Prep

# ---- AI video verification (optional) -----------------------
# "mock" = no external calls. "gemini" needs GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash.
GEMINI_MODEL=

# ---- YouTube Data API (optional) ----------------------------
YOUTUBE_API_KEY=

# ---- LeetCode sync (optional) -------------------------------
LEETCODE_SYNC_SECRET=
